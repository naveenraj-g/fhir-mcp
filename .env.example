# Copy to .env (gitignored). Only secrets and per-environment overrides belong
# here — behavior lives in configs/*.yaml. Any nested setting can be
# overridden with `__`, e.g. CONNECTORS__ACTIVE=medplum.

# Which backend, and which plugin generates its tools.
# CONNECTORS__ACTIVE=universal               # universal | internal | medplum
# CONNECTORS__INTERNAL__PLUGIN=rest        # rest | graphql

# IAM (BetterAuth) the caller's token is verified against.
# AUTH__JWKS_URL=http://localhost:5001/api/auth/jwks
# AUTH__ISSUER=http://localhost:5001

# universal (fhir-gql): it requires a token even for introspection. A valid
# JWT, used once at startup to discover tools (or set
# CONNECTORS__UNIVERSAL__GRAPHQL__SCHEMA_FILE instead).
# CONNECTORS__UNIVERSAL__DISCOVERY_TOKEN=

# internal + graphql: fhir-gql requires a token even for introspection.
# A valid JWT, used once at startup to discover tools (or set
# CONNECTORS__INTERNAL__GRAPHQL__SCHEMA_FILE instead).
# CONNECTORS__INTERNAL__DISCOVERY_TOKEN=

# medplum: this server's own Medplum ClientApplication (Project Admin -> Clients).
# CONNECTORS__MEDPLUM__CLIENT_ID=
# CONNECTORS__MEDPLUM__CLIENT_SECRET=
